#include "Base.xcconfig"

// Local API (docker-compose / `pnpm --filter @evtap/api dev`). On a physical device use your Mac's LAN IP,
// e.g. http:/$()/192.168.1.20:4000 (NSAllowsLocalNetworking is enabled in Info-Debug.plist).
API_BASE_URL = http:/$()/localhost:4000

INFOPLIST_FILE = Supporting/Info-Debug.plist
APS_ENVIRONMENT = development
