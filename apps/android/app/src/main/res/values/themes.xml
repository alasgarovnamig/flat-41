<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat parent: required by AppCompatDelegate.setApplicationLocales (per-app language on API < 33).
         All visible UI is Compose (EvTapTheme); this only styles the window. -->
    <style name="Theme.EvTap" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/evtap_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/evtap_ink</item>
        <item name="colorAccent">@color/evtap_ink</item>
    </style>

    <style name="Theme.EvTap.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/evtap_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/evtap_ink</item>
        <item name="postSplashScreenTheme">@style/Theme.EvTap</item>
    </style>
</resources>
