# API origin (without /api/v1).
#   iOS simulator: http://localhost:4000 · Android emulator: http://10.0.2.2:4000 · device: http://<LAN-IP>:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
# Public website for share links
EXPO_PUBLIC_WEB_URL=https://evtap.az
# Google Maps SDK for Android (required on Android); iOS uses Apple Maps unless GOOGLE_MAPS_IOS_API_KEY is set
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
# EAS project id (`eas init`) — required for Expo push tokens
EAS_PROJECT_ID=
