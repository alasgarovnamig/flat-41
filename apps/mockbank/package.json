{
  "name": "@evtap/mockbank",
  "version": "1.0.0",
  "private": true,
  "description": "Mock acquiring bank / card payment gateway (hosted checkout, 3-D Secure, signed webhooks, refunds, saved cards)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
