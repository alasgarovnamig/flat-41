# Mock bank (apps/mockbank, Go) — copy to .env or export in your shell.
# `pnpm dev` (go run ./cmd/mockbank) and the binary load ./.env when present (real env vars win);
# defaults below work as-is.

# development | test | production (production hides the test-card table). APP_ENV wins over NODE_ENV.
NODE_ENV=development
PORT=4100
# Public base URL used for paymentUrl / checkout links (what the browser or mobile WebView opens).
# Falls back to MOCKBANK_PUBLIC_URL, then http://localhost:$PORT.
PUBLIC_URL=http://localhost:4100
DATABASE_URL=postgres://evtap:evtap@localhost:5432/mockbank

# Merchants: id:secret:displayName, comma-separated. Must match the API's MOCKBANK_MERCHANT_ID / MOCKBANK_SECRET.
MERCHANTS=evtap:evtap-mockbank-secret:EvTap

# Bank admin UI at /admin (HTTP basic auth)
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# --- optional / dev knobs ---
# Multiplier for the webhook retry schedule (5s, 30s, 2m, 10m, 1h, 6h). e.g. 0.01 → 50ms … 3.6min
WEBHOOK_RETRY_SCALE=1
# Per-attempt webhook HTTP timeout (ms)
WEBHOOK_TIMEOUT_MS=10000
# Background loop interval (webhook retries + order expiry), ms
SCHEDULER_INTERVAL_MS=1000
# Minutes before an unpaid order becomes EXPIRED (contract: 30)
ORDER_TTL_MINUTES=30
# debug | info | warn | error | silent
LOG_LEVEL=info
