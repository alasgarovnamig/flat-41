NODE_ENV=development
PORT=4000
# Public URL of this API (used to build upload URLs and bank return/webhook URLs)
API_PUBLIC_URL=http://localhost:4000
# URL the bank uses to call our webhook (docker: http://api:4000)
API_INTERNAL_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
DATABASE_URL=postgres://evtap:evtap@localhost:5432/evtap

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=30

# Storage: "local" (./uploads served at /uploads) or "s3" (any S3-compatible e.g. MinIO, R2)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# SMS: "console" logs OTP codes; replace with a real provider later (e.g. "lsim", "twilio")
SMS_PROVIDER=console
# Fixed OTP for development / app-store review accounts (empty = random)
OTP_DEV_CODE=111111

# Payments — mock bank (see apps/mockbank)
PAYMENT_PROVIDER=mockbank
MOCKBANK_URL=http://localhost:4100
MOCKBANK_PUBLIC_URL=http://localhost:4100
MOCKBANK_MERCHANT_ID=evtap
MOCKBANK_SECRET=evtap-mockbank-secret

# Push notifications via Expo push service ("expo" | "console")
PUSH_PROVIDER=console
EXPO_ACCESS_TOKEN=

# Seed admin
ADMIN_EMAIL=admin@evtap.az
ADMIN_PASSWORD=Admin12345!
